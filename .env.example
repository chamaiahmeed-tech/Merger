# انسخ هذا الملف إلى .env.local وضع القيم الحقيقية (ونفس القيم في Vercel → Settings → Environment Variables)

TURSO_DATABASE_URL=turso://<db-name>-<org>.turso.io
TURSO_AUTH_TOKEN=<Turso token بصلاحيات كتابة>

# خدمة دمج الفيديو (Video Merger API v2) — الرابط العام بعد نشرها على Vercel
MERGER_API_BASE=https://your-merger-service.vercel.app

# اختياري — إن ضُبط يُطلب Bearer token على /mcp
MCP_ACCESS_TOKEN=

# اختياري — تجاوز أسماء الموديلات إن لزم
KIE_IMAGE_MODEL=
KIE_VIDEO_MODEL=
COMETAPI_IMAGE_MODEL=
COMETAPI_VIDEO_MODEL=
